ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=*
API_V1_PREFIX=/api/v1

# Optional: set to use real OpenAI models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Celery/Redis
# For Docker Compose use redis://redis:6379/0
# For local dev without Docker use redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_EAGER=false

# Redis pubsub for WebSocket updates
REDIS_URL=redis://redis:6379/0

# Postgres
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/automation

# Auth/JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Optional OpenTelemetry exporter
OTLP_ENDPOINT=

# Initial admin bootstrap (optional)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123
